{
  "id": null,
  "uid": "bookclub-logs",
  "title": "Logs",
  "tags": ["bookclub", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "bookclub-loki" },
        "query": "label_values(service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "bookclub-loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({project=\"bookclub\", service=~\"$service\"}[1m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Log volume by level",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "bookclub-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(count_over_time({project=\"bookclub\", service=~\"$service\"} | level != \"\" [1m])) by (level)",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error / exception rate",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "bookclub-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({project=\"bookclub\", service=~\"$service\"} |~ \"(?i)(error|exception|traceback|critical)\" [1m]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Live logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "bookclub-loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{project=\"bookclub\", service=~\"$service\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
