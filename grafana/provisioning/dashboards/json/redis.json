{
  "id": null,
  "uid": "bookclub-redis",
  "title": "Redis",
  "tags": ["bookclub", "redis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Redis up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "redis_up{job=\"redis\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Connected clients",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "redis_connected_clients{job=\"redis\"}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Used memory",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "redis_memory_used_bytes{job=\"redis\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Evicted keys total",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "redis_evicted_keys_total{job=\"redis\"}", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Commands processed / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(redis_commands_processed_total{job=\"redis\"}[5m])", "legendFormat": "commands/s", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Hit rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) / (rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) + rate(redis_keyspace_misses_total{job=\"redis\"}[5m]))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Memory usage over time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "redis_memory_used_bytes{job=\"redis\"}", "legendFormat": "used", "refId": "A" },
        { "expr": "redis_memory_max_bytes{job=\"redis\"}", "legendFormat": "max", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "title": "Expired keys / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "bookclub-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "rate(redis_expired_keys_total{job=\"redis\"}[5m])", "legendFormat": "expired/s", "refId": "A" }
      ]
    }
  ]
}
